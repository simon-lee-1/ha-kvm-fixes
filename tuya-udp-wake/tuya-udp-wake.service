[Unit]
Description=Tuya UDP Wake Broadcast Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/tuya-udp-wake/tuya_wake.py
Restart=always
RestartSec=10
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
User=nobody
Group=nogroup

[Install]
WantedBy=multi-user.target
